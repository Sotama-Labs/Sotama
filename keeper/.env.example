# Sotama keeper — devnet defaults

# Helius API key (https://dashboard.helius.dev)
HELIUS_API_KEY=

# Helius devnet RPC and Enhanced WebSocket endpoints
HELIUS_DEVNET_RPC=https://devnet.helius-rpc.com
HELIUS_DEVNET_WS=wss://devnet.helius-rpc.com

# Helius Sender — only exists for mainnet (`sender.helius-rpc.com/fast`,
# global with regional autorouting). Devnet has no Sender equivalent;
# fall back to the standard devnet RPC.
HELIUS_DEVNET_SENDER=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Jupiter Developer-tier API key (10 rpm). Sent as `x-api-key` on every
# Jupiter call. Leave blank to use the free-tier `lite-api.jup.ag`
# route with stricter rate limits.
JUPITER_API_KEY=
#   Paid: https://api.jup.ag/price/v3        (requires JUPITER_API_KEY)
#   Free: https://lite-api.jup.ag/price/v3   (no key, throttled)
JUPITER_PRICE_URL=https://api.jup.ag/price/v3

# Path to the keeper signing keypair (must equal Config.keeper on-chain).
KEEPER_KEYPAIR_PATH=./keeper-keypair.json

# Sotama on-chain program ID (devnet).
PROGRAM_ID=5U9GqtAmk2pKXMPfBYVVAhQ7AmNUEztW1bfZaEJarK5g

# Reconciliation cadence (seconds) — full getProgramAccounts sweep.
RECONCILE_INTERVAL_SECS=60

# Per-shard cap for transactionSubscribe accountInclude.
SHARD_SIZE=40

# Logging — RUST_LOG style. Defaults to info if unset.
RUST_LOG=info,sotama_keeper=debug
