# Sotama keeper — devnet defaults

# Helius API key (https://dashboard.helius.dev)
HELIUS_API_KEY=

# Helius devnet RPC and Atlas WebSocket endpoints
HELIUS_DEVNET_RPC=https://devnet.helius-rpc.com
HELIUS_DEVNET_WS=wss://atlas-devnet.helius-rpc.com

# Helius Sender — devnet fast endpoint (no Jito tip required on devnet,
# but we still send a small priority fee to keep the keeper code identical
# to mainnet behavior).
HELIUS_DEVNET_SENDER=https://devnet-sender.helius-rpc.com/fast

# Path to the keeper signing keypair (must equal Config.keeper on-chain).
KEEPER_KEYPAIR_PATH=./keeper-keypair.json

# Sotama on-chain program ID (devnet).
PROGRAM_ID=2gp9bMBEVpQp6Lyyg13Bw6XF9S9saAcm9C4XQ69T8ZqQ

# Reconciliation cadence (seconds) — full getProgramAccounts sweep.
RECONCILE_INTERVAL_SECS=60

# Per-shard cap for transactionSubscribe accountInclude (Helius Atlas
# limit is 50; we use 40 for headroom).
SHARD_SIZE=40

# Logging — RUST_LOG style. Defaults to info if unset.
RUST_LOG=info,sotama_keeper=debug
