# ── Network ────────────────────────────────────────────────────────────
# Sotama runs on devnet. Mainnet is supported but the keeper + escrow program
# only target devnet today.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ── Helius RPC (devnet) ────────────────────────────────────────────────
# Sign up at https://www.helius.dev/ — free tier covers this build.
# Devnet:  https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_RPC_URL=

# ── Mainnet metadata fallback (read-only) ──────────────────────────────
# Used only by the token resolver: when a pasted CA has no devnet metadata
# we look it up on mainnet purely so the user sees the correct ticker/logo
# for canonical tokens (JTO, BONK, etc.). No transactions are sent here.
NEXT_PUBLIC_HELIUS_MAINNET_RPC_URL=

# ── Pyth Hermes (price oracle) ─────────────────────────────────────────
# Live price feeds for Token Price triggers. Hermes is global and works
# regardless of cluster. Default endpoint is fine for most use; swap in a
# self-hosted Hermes if you need higher rate limits.
NEXT_PUBLIC_PYTH_HERMES_URL=https://hermes.pyth.network

# ── Sotama on-chain program ────────────────────────────────────────────
# Set after `pnpm anchor:deploy:devnet`. The default below matches the
# program keypair generated during scaffolding — replace if you redeploy
# under a fresh keypair.
NEXT_PUBLIC_SOTAMA_PROGRAM_ID=2gp9bMBEVpQp6Lyyg13Bw6XF9S9saAcm9C4XQ69T8ZqQ

# ── Keeper sidecar (optional) ──────────────────────────────────────────
# When set, /api/automations POSTs the serialized automation to the keeper
# in addition to on-chain create. The keeper still works without this —
# it indexes the program directly via getProgramAccounts.
NEXT_PUBLIC_KEEPER_URL=
