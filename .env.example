# ── Network ────────────────────────────────────────────────────────────
# Sotama defaults to devnet for local development. Mainnet is live, but use
# the mainnet program ID only with explicit production approval.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ── Helius RPC (frontend) ──────────────────────────────────────────────
# Use a Helius Secure RPC URL here, not a raw `?api-key=...` URL.
# Every NEXT_PUBLIC_* value is visible in the browser bundle.
NEXT_PUBLIC_HELIUS_RPC_URL=

# ── Mainnet metadata fallback (read-only) ──────────────────────────────
# Used only by the token resolver. If set, this should also be a Secure RPC URL.
NEXT_PUBLIC_HELIUS_MAINNET_RPC_URL=

# ── Pyth Hermes (price oracle) ─────────────────────────────────────────
# Live price feeds for Token Price triggers. Hermes is global and works
# regardless of cluster. Default endpoint is fine for most use; swap in a
# self-hosted Hermes if you need higher rate limits.
NEXT_PUBLIC_PYTH_HERMES_URL=https://hermes.pyth.network

# ── Sotama on-chain program ────────────────────────────────────────────
# Devnet program ID from the current handoff. Mainnet:
# FWv1i9zufohHyezBsfrtyKXX8SWSwFEKXiS6FqrqzZzd
NEXT_PUBLIC_SOTAMA_PROGRAM_ID=5U9GqtAmk2pKXMPfBYVVAhQ7AmNUEztW1bfZaEJarK5g

# ── Keeper sidecar (optional) ──────────────────────────────────────────
# When set, /api/automations POSTs the serialized automation to the keeper
# in addition to on-chain create. The keeper still works without this —
# it indexes the program directly via getProgramAccounts.
NEXT_PUBLIC_KEEPER_URL=

# ── Keeper runtime tuning (keeper/ binary) ─────────────────────────────
# Priority fee floor + ceiling in microlamports/CU. Cache reads are clamped
# into this range so a stale/zero cache still ships in the SWQoS-preferred
# lane and a runaway Helius spike can't drain operating SOL on one tx.
# Defaults: floor=50_000, ceiling=1_000_000 (max ~0.001 SOL per swap tx).
# KEEPER_PRIORITY_FEE_FLOOR=50000
# KEEPER_PRIORITY_FEE_CEILING=1000000

# Compute-unit ceilings per action type. Static today; once we wire
# simulateTransaction we'll size dynamically. Defaults: swap=800k,
# bridge=700k, transfer=200k.
# KEEPER_CU_LIMIT_SWAP=800000
# KEEPER_CU_LIMIT_BRIDGE=700000
# KEEPER_CU_LIMIT_DEFAULT=200000

# Helius Sender opt-in. When 1, every tx includes a 0.0002 SOL Jito tip
# and posts to sender.helius-rpc.com/fast (50 TPS, dual-routed
# validators + Jito, 0 credits/tx). Tip is paid from keeper operating
# SOL. Region auto-derives from FLY_REGION (slc/ewr/lon/fra/ams/sg/tyo)
# when KEEPER_SENDER_REGION is unset; falls back to global hostname.
# KEEPER_USE_SENDER=0
# KEEPER_SENDER_TIP_LAMPORTS=200000
# KEEPER_SENDER_REGION=
