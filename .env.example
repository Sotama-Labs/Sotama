# Helius RPC — sign up at https://www.helius.dev/ and paste your URL.
# Mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Devnet:  https://devnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_RPC_URL=

# Network label surfaced in the UI ("mainnet-beta" | "devnet").
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Jupiter Price API v3.
# Default points at api.jup.ag — keyless at 0.5 RPS (lite-api.jup.ag is being
# progressively retired since the Developer Platform launch on 2026-04-06).
# For higher rate limits, sign up at https://portal.jup.ag and paste the key
# below — it gets sent as the `x-api-key` header.
NEXT_PUBLIC_JUPITER_PRICE_URL=https://api.jup.ag/price/v3
NEXT_PUBLIC_JUPITER_API_KEY=
